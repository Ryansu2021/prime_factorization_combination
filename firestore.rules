rules_version = '2';

// ============================================================
//  數字大挑戰 Firestore 安全規則
//  使用方式：複製全部內容，貼到 Firebase 主控台 → Firestore Database → 規則 → 發布
//  ⚠️ 請把下方 YOUR_TEACHER_EMAIL@gmail.com 改成你登入教師 dashboard 用的 Google 帳號
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isTeacher() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['YOUR_TEACHER_EMAIL@gmail.com'];
    }

    function sessionActive(code) {
      return get(/databases/$(database)/documents/sessions/$(code)).data.active == true;
    }

    // 課堂：學生只能讀取「單一課堂」確認代碼是否存在；建立、列出、修改、刪除只有教師可以
    match /sessions/{code} {
      allow get: if request.auth != null;
      allow list, create, update, delete: if isTeacher();

      // 每位學生一份資料，文件 ID 就是座號
      match /students/{seat} {
        // 教師可以讀取與刪除全班；學生只能讀取自己的那一份（用來重新整理後接續進度）
        allow get: if isTeacher()
          || (request.auth != null && (resource == null || resource.data.uid == request.auth.uid));
        allow list, delete: if isTeacher();

        // 學生建立自己的座號資料：課堂必須進行中、座號為 1~99、uid 必須是自己
        allow create: if request.auth != null
          && seat.matches('^[1-9][0-9]?$')
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.seat == int(seat)
          && sessionActive(code);

        // 學生只能更新自己的資料，不能改 uid 和座號
        allow update: if request.auth != null
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.seat == resource.data.seat
          && sessionActive(code);
      }
    }
  }
}
